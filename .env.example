# === Required ===
CHANNEL_BROWSER_URL=
PROGRAM_ID=

# === Required RTMP output ===
# Full publish URLs separated by spaces, commas, or newlines.
# RTMP_OUTPUTS=rtmp://a.rtmp.youtube.com/live2/YOUTUBE_KEY rtmp://example.com/live/OTHER_KEY
# Compatibility fallback when RTMP_OUTPUTS is empty:
YOUTUBE_STREAM_KEY=

# === Video tuning (optional) ===
# RESOLUTION=1920x1080
# WINDOW_SIZE=1920x1080
# FPS=30
# DRAW_MOUSE=0
# VIDEO_ENCODER=libx264
# X264_PRESET=veryfast
# VIDEO_BITRATE=6000k
# VIDEO_MAXRATE=6000k
# VIDEO_BUFSIZE=12000k
# GOP_SIZE=60
# AUDIO_BITRATE=128k

# === Optional concurrent LiveKit output ===
# Publishes the same rendered page as H.264 + Opus while RTMP remains live.
# LIVEKIT_ENABLED=1
# LIVEKIT_URL=ws://livekit:7880
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=replace-with-at-least-32-random-characters
# LIVEKIT_ROOM=alcantara-modoitaliano
# LIVEKIT_IDENTITY=program-feed-modoitaliano
# LIVEKIT_METADATA={"role":"program-feed","programId":"modoitaliano"}

# === GPU passthrough (Linux only, uncomment for VAAPI hardware encoding) ===
# VAAPI_DEVICE=/dev/dri/renderD129
# VAAPI_DRIVER=iHD

# === Chrome tuning (optional) ===
# DISABLE_CHROME_GPU=0
# CHROME_SOFTWARE_GL=0
# CHROME_DISABLE_DEV_SHM_USAGE=0
# CHROME_ENABLE_PERF_FLAGS=0
# CHROME_EXTRA_FLAGS=--num-raster-threads=1
# BROWSER_WAIT_FOR_URL=1
# STALL_TIMEOUT=30
# RESTART_BACKOFF=5
# MAX_BACKOFF=60
# HEALTHY_RESET_SECONDS=60
# ALLOW_SOFTWARE_FALLBACK=0

# === Other ===
# PLATFORM=linux/arm64
# IMAGE_NAME=alana:local
# SHM_SIZE=1g
# CHROME_DEVTOOLS_PORT=9222
