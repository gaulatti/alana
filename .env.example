# === Required ===
YOUTUBE_STREAM_KEY=
CHANNEL_BROWSER_URL=

# === Video tuning (optional) ===
# RESOLUTION=1920x1080
# WINDOW_SIZE=1920x1080
# FPS=30
# DRAW_MOUSE=0
# VIDEO_ENCODER=libx264
# X264_PRESET=veryfast
# VIDEO_BITRATE=6000k
# VIDEO_MAXRATE=6000k
# VIDEO_BUFSIZE=12000k
# GOP_SIZE=60
# AUDIO_BITRATE=128k

# === Icecast / radio mode (uncomment for audio-only streaming) ===
# STREAM_MODE=icecast
# ICECAST_HOST=localhost
# ICECAST_PORT=8000
# ICECAST_MOUNT=/stream.mp3
# ICECAST_SOURCE_PASSWORD=hackme
# ICECAST_CODEC=mp3
# ICECAST_BITRATE=128k
# ICECAST_STREAM_NAME=Alana Radio

# === GPU passthrough (Linux only, uncomment for VAAPI hardware encoding) ===
# VAAPI_DEVICE=/dev/dri/renderD129
# VAAPI_DRIVER=iHD

# === Chrome tuning (optional) ===
# DISABLE_CHROME_GPU=0
# CHROME_SOFTWARE_GL=0
# CHROME_DISABLE_DEV_SHM_USAGE=0
# CHROME_ENABLE_PERF_FLAGS=0
# CHROME_EXTRA_FLAGS=--num-raster-threads=1

# === Other ===
# SHM_SIZE=1g
# FFMPEG_LOGLEVEL=warning
# CHROME_DEVTOOLS_PORT=9222
